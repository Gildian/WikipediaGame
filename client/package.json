{
  "name": "wikipedia-path-finder-frontend",
  "version": "1.0.0",
  "description": "React frontend for the Wikipedia Path Finder application",
  "type": "module",
  "private": true,
  "keywords": [
    "wikipedia",
    "react",
    "pathfinding",
    "frontend",
    "nlp",
    "vite"
  ],
  "author": {
    "name": "Gildian Gonzales",
    "url": "https://github.com/Gildian"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gildian/WikipediaGame.git",
    "directory": "client"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,scss}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.2",
    "sass": "^1.71.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "prettier": "^3.0.0",
    "vite": "^5.1.4",
    "vitest": "^1.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
