{
  "name": "wikipedia-path-finder-backend",
  "version": "1.0.0",
  "description": "Express.js API server for the Wikipedia Path Finder bot",
  "main": "server.js",
  "keywords": [
    "wikipedia",
    "pathfinding",
    "nlp", 
    "api",
    "express",
    "machine-learning"
  ],
  "author": {
    "name": "Gildian Gonzales",
    "url": "https://github.com/Gildian"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gildian/WikipediaGame.git",
    "directory": "bot"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js --ignore path.json --ignore glove_cache/",
    "client": "npm run dev --prefix ../client/",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint *.js",
    "format": "prettier --write *.js",
    "bot:random": "python main.py random",
    "bot:interactive": "python main.py",
    "bot:help": "python main.py --help"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "path.json",
      "glove_cache/",
      "__pycache__/",
      "*.pyc"
    ],
    "delay": 1000
  }
}
